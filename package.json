{
  "name": "flaregit",
  "version": "0.1.0",
  "description": "FlareGit - Independent Git contributions from humans and coding agents, coordinated and accepted through human review.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/tooling/dev-web.ts",
    "build": "bun src/tooling/build-web.ts",
    "typecheck": "tsc --noEmit",
    "build:cli": "bun build --compile cli/flaregit.ts --outfile dist-cli/flaregit",
    "lint": "eslint src/",
    "test": "bun test",
    "demo": "bun run src/cli/demo.ts",
    "server": "bun run src/server/local.ts",
    "demo:proof": "bun run src/cli/proof.ts",
    "demo:hosted": "bun run src/cli/acceptance.ts"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/bun": "latest",
    "@types/diff": "^8.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "miniflare": "5.20261001.0-alpha",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "wrangler": "^4.146.0"
  }
}
