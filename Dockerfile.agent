# Dependency acquisition is a separate build stage. Candidate jobs never install packages.
FROM oven/bun:1.3.4 AS dependencies
WORKDIR /opt/execution-deps
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production --ignore-scripts

# This image contains public tooling and dependencies, not platform source or authority.
FROM oven/bun:1.3.4
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=dependencies /opt/execution-deps/node_modules /opt/execution-deps/node_modules
RUN mkdir -p /job/home /job/tmp /workspace && chown -R bun:bun /job /workspace
WORKDIR /job
ENV HOME=/job/home TMPDIR=/job/tmp NODE_ENV=production
USER bun
ENTRYPOINT ["sleep", "infinity"]
